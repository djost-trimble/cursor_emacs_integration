# Cursor Bridge Service Configuration

# Cursor API Key (required)
# Get your API key from https://cursor.com/settings
CURSOR_API_KEY=

# Cursor API Endpoint (optional)
# Use default cloud endpoint or specify local MCP server
CURSOR_ENDPOINT=https://cursor.com/api

# Prefer local models via MCP (optional)
# Set to 'true' to use local models when available
PREFER_LOCAL_MODELS=false

# HTTP Server Port (default: 8765)
HTTP_PORT=8765

# WebSocket Port (default: same as HTTP)
WS_PORT=8766

# Database Path (optional)
# Path to SQLite database for session persistence
# Default: ~/.cursor-bridge/sessions.db
# DB_PATH=/path/to/sessions.db

# Node Environment (optional)
NODE_ENV=development
